# Production & Server Environment Variables

# Application URL
APP_URL="https://www.jaioctginspection.com"

# Secret Key for JWT Signing & Authentication Session Validation
JWT_SECRET=""

# Gemini AI API Key (Server-Side Only)
GEMINI_API_KEY=""

# Relational Database Connection (Server-Side Only)
DATABASE_URL=""

# Microsoft Graph / Microsoft Entra ID Mail Configuration (Server-Side Only)
MICROSOFT_TENANT_ID="your-azure-tenant-id"
MICROSOFT_CLIENT_ID="your-azure-client-id"
MICROSOFT_CLIENT_SECRET="your-azure-client-secret"
MICROSOFT_SENDER_EMAIL="jsankar@jaioctginspection.com"
COMPANY_EMAIL="jsankar@jaioctginspection.com"
MANAGER_EMAIL="sakesankar@yahoo.com.sg"

# Allowed CORS Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS="https://www.jaioctginspection.com,https://jaioctginspection.com"

# Public API URL for Standalone Frontend Hosting (e.g. Netlify/Vercel/Custom Domain)
VITE_API_BASE_URL="https://api.jaioctginspection.com"
